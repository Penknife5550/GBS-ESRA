# =============================================================================
# GBS Campus — Umgebungsvariablen
#
# Kopieren nach .env und ausfuellen. Die .env gehoert NIE ins Repository und
# NIE ins Image — nur auf den Server und in den Break-Glass-Tresor (E-12).
# =============================================================================

# --- Domain & URL ------------------------------------------------------------
# Festgelegt am 27.07.2026 (Entscheidung E-09).
# Ohne korrekte APP_URL erzeugt die App Magic-Links auf http://localhost:3000 —
# das ist ein Totalausfall des Logins, weil der Magic-Link der einzige
# Kontoschluessel ist.
APP_DOMAIN=gbs.fes-credo.de
APP_URL=https://gbs.fes-credo.de
ACME_EMAIL=

# --- Datenbank ---------------------------------------------------------------
DB_PASSWORD=
# Nur fuer lokale Entwicklung ohne Docker-Compose noetig:
DATABASE_URL="postgresql://gbs:passwort@localhost:5433/gbs_campus?schema=public"

# --- Sitzungen ---------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=

# --- Verschluesselung sensibler Felder (IBAN) --------------------------------
# openssl rand -hex 32  →  exakt 64 Hex-Zeichen
# ACHTUNG: Ohne diesen Schluessel ist jedes Backup wertlos. Er gehoert getrennt
# vom Backup in den versiegelten Notfall-Tresor.
ENCRYPTION_KEY=

# --- E-Mail-Versand ----------------------------------------------------------
# SPF, DKIM und DMARC muessen fuer die ABSENDERDOMAIN gesetzt sein — das ist die
# Domain hinter MAIL_ABSENDER_ADRESSE (gbs-minden.de), NICHT die APP_DOMAIN
# (gbs.fes-credo.de). Vor dem Livegang gegen GMX, web.de, Gmail und Outlook
# verifizieren: landet der Magic-Link im Posteingang oder im Spam?
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_ABSENDER_NAME="Gemeindebibelschule Minden"
# Festgelegt: Absenderadresse der Schule. SPF/DKIM/DMARC gelten fuer gbs-minden.de.
MAIL_ABSENDER_ADRESSE=no-reply@gbs-minden.de
# Antwortadresse: no-reply@ nimmt keine Antworten an. Sobald ein betreutes
# Postfach feststeht (z. B. sekretariat@gbs-minden.de), hier eintragen — sonst
# laufen Rueckfragen der Teilnehmer ins Leere.
MAIL_ANTWORT_AN=

# --- Semesterüberleitung: Erinnerungslauf (Cron) -----------------------------
# Der Endpunkt /api/cron/erinnerungen verschickt die Erinnerungen T-14/-7/-3 vor
# Semesterstart. Er wird von einem externen Zeitgeber (systemd-Timer, Cron,
# Uptime-Ping) einmal taeglich aufgerufen und ueber dieses gemeinsame Geheimnis
# geschuetzt (Header x-cron-secret). Ohne CRON_SECRET weist der Endpunkt jeden
# Aufruf mit 503 ab — die Erinnerungen gehen dann nicht raus.
#   openssl rand -hex 24  (mindestens 16 Zeichen)
#   curl -fsS -X POST -H "x-cron-secret: $CRON_SECRET" https://gbs.fes-credo.de/api/cron/erinnerungen
CRON_SECRET=

# --- Betrieb -----------------------------------------------------------------
TZ=Europe/Berlin
# Aufbewahrung der naechtlichen Backups in Tagen (Bauplan: 30-90)
BACKUP_AUFBEWAHRUNG_TAGE=60
